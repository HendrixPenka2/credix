        <mxCell id="note_bottom" value="Ce flux ne produit aucune estimation du risque de defaut.&#10;Son orthogonalite au defaut est un resultat attendu, verifie au chapitre 3." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
