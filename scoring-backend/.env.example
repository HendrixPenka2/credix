# ============================================================
# SCORING BACKEND — CONFIGURATION
# Copiez ce fichier en .env (cp .env.example .env) puis adaptez
# les valeurs marquées « À CHANGER ».
# Ne publiez JAMAIS le fichier .env (il contient des secrets).
# ============================================================

# === MODE ARTEFACTS ===
# false → charge les vrais fichiers du modèle (dossier artefacts/, fournis dans le dépôt)
# true  → fichiers factices, pour développer seulement (Flux B désactivé, PD non calibrée)
USE_MOCK_ARTEFACTS=false

# === CHEMINS ARTEFACTS ===
# Dossier contenant les fichiers du modèle produits par le notebook (fournis dans artefacts/)
ARTEFACTS_DIR=./artefacts

# === DONNÉES HOME CREDIT (FACULTATIF) ===
# Inutile pour tester l'application : des clients de démonstration sont fournis dans demo_data/.
# À renseigner seulement pour recharger la base complète avec seed_database.py.
# Fichiers Kaggle attendus : application_test.csv, bureau.csv, POS_CASH_balance.csv,
#   installments_payments.csv, previous_application.csv
# Exemple Linux : /home/tonnom/data/home_credit
HOME_CREDIT_DATA_DIR=METTRE_LE_CHEMIN_ICI

# === MONGODB ===
# Adresse valable dans Docker : les scripts se lancent dans le conteneur (docker compose exec api ...).
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=scoring_db

# === SÉCURITÉ JWT ===
# À CHANGER. Générez une valeur : openssl rand -hex 32
JWT_SECRET=CHANGE_MOI_EN_PRODUCTION_cle_secrete_longue
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# === LLM POUR generate_metadata.py (FACULTATIF) ===
# Inutile pour tester : les phrases d'explication sont fournies dans demo_data/.
# Une clé ne sert que pour les régénérer avec generate_metadata.py.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=METTRE_TA_CLE_GEMINI_ICI
ANTHROPIC_API_KEY=

# === PDF WORKER ===
PDF_WORKER_URL=http://pdf-worker:8001

# === SEUILS PDO (valeurs de repli) ===
# Les seuils réellement appliqués viennent de artefacts/decision_config.json, puis de la
# configuration Admin. Ces valeurs ne servent que si ce fichier est absent.
PDO_SEUIL_ACCORDE=578.5
PDO_SEUIL_REFUSE=539.5

# === MONITORING PSI ===
PSI_SEUIL_ATTENTION=0.10
PSI_SEUIL_DERIVE=0.25

# === COUVERTURE rho_c ===
RHO_SEUIL_BANNIERE=0.42
RHO_SEUIL_REVUE_FORCEE=0.25

# === MLFLOW ===
MLFLOW_TRACKING_URI=http://mlflow:5000

# === CORS ===
# Adresses autorisées à appeler l'API : le frontend tourne sur le port 3001.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
