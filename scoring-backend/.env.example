# ============================================================
# SCORING BACKEND — CONFIGURATION
# Copie ce fichier en .env et remplis les valeurs
# ============================================================

# === MODE ARTEFACTS ===
# true  → utilise des artefacts factices (pour développer sans les vrais fichiers)
# false → charge les vrais artefacts depuis ARTEFACTS_DIR
USE_MOCK_ARTEFACTS=false

# === CHEMINS ARTEFACTS ===
# Dossier contenant tes 5 fichiers produits par le notebook Kaggle
ARTEFACTS_DIR=./artefacts

# === CHEMINS CSV HOME CREDIT ===
# ⚠️  ICI : mets le chemin complet de ton dossier CSV Home Credit
# Exemple Windows : C:/Users/TonNom/Documents/home_credit_data
# Exemple Linux   : /home/tonnom/data/home_credit
# Fichiers attendus : application_test.csv, bureau.csv,
#   installments_payments.csv, POS_CASH_balance.csv,
#   credit_card_balance.csv, previous_application.csv
HOME_CREDIT_DATA_DIR=METTRE_LE_CHEMIN_ICI

# === MONGODB ===
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=scoring_db

# === SÉCURITÉ JWT ===
# Génère une valeur : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_MOI_EN_PRODUCTION_cle_secrete_longue
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# === LLM POUR generate_metadata.py ===
LLM_PROVIDER=gemini
GOOGLE_API_KEY=METTRE_TA_CLE_GEMINI_ICI
ANTHROPIC_API_KEY=

# === PDF WORKER ===
PDF_WORKER_URL=http://pdf-worker:8001

# === SEUILS PDO ===
PDO_SEUIL_ACCORDE=600
PDO_SEUIL_REFUSE=500

# === MONITORING PSI ===
PSI_SEUIL_ATTENTION=0.10
PSI_SEUIL_DERIVE=0.25

# === COUVERTURE rho_c ===
RHO_SEUIL_BANNIERE=0.40
RHO_SEUIL_REVUE_FORCEE=0.25

# === MLFLOW ===
MLFLOW_TRACKING_URI=http://mlflow:5000

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
